{
  "backends": [
    {
      "id": "llama.cpp",
      "name": "llama.cpp (llama-server)",
      "description": "CPU+GPU GGUF inference from ggml-org/llama.cpp. CPU, CUDA, and Vulkan builds; ships its own OpenAI-compatible server.",
      "formats": ["gguf"],
      "binary": {
        "kind": "github-release",
        "url": "https://api.github.com/repos/ggml-org/llama.cpp/releases/latest",
        "assetMatch": {
          "windows": "cublas",
          "linux": "cuda-cu12",
          "darwin": "os-arm64"
        },
        "extract": "zip",
        "binaryName": "llama-server"
      },
      "runtime": {
        "portFlag": "--port {port}",
        "modelFlag": "--model {model}",
        "argsTemplate": "--host 127.0.0.1 --ctx-size {ctx} --n-gpu-layers {ngl}",
        "vars": [
          { "name": "ctx", "default": "4096" },
          { "name": "ngl", "default": "99" }
        ],
        "healthPath": "/health",
        "healthTimeoutS": 180,
        "stopGraceS": 10
      }
    },
    {
      "id": "ollama",
      "name": "Ollama (attach)",
      "description": "Attach to an already-running Ollama daemon. llmctl proxies it; model pulls stay in ollama. Install ollama.com separately.",
      "formats": ["gguf", "safetensors"],
      "binary": { "kind": "path", "binaryName": "ollama" },
      "runtime": {
        "portFlag": "",
        "modelFlag": "",
        "healthPath": "/api/version",
        "healthTimeoutS": 10,
        "chatCompletionsPath": "/v1/chat/completions"
      }
    },
    {
      "id": "vllm",
      "name": "vLLM (attach)",
      "description": "Attach to a running vLLM OpenAI server (Linux + NVIDIA, pip install vllm). Highest-throughput continuous-batching engine.",
      "formats": ["safetensors"],
      "requiresGpu": true,
      "binary": { "kind": "path", "binaryName": "vllm" },
      "runtime": {
        "portFlag": "--port {port}",
        "modelFlag": "",
        "argsTemplate": "serve {model_dir} --host 127.0.0.1 --tensor-parallel-size {tp}",
        "vars": [{ "name": "tp", "default": "1" }],
        "healthPath": "/health",
        "healthTimeoutS": 600
      }
    },
    {
      "id": "custom",
      "name": "Custom OpenAI-compatible server (attach)",
      "description": "Point llmctl at any OpenAI-compatible server already running (LM Studio, TGI, Triton, remote host).",
      "binary": { "kind": "path", "binaryName": "" },
      "runtime": {
        "portFlag": "",
        "modelFlag": "",
        "healthPath": "/v1/models",
        "healthTimeoutS": 10
      }
    }
  ],
